<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvKode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kode Servis"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPlat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plat Nomor"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvKeluhan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keluhan"
            android:layout_marginTop="4dp" />

        <Spinner
            android:id="@+id/spStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <Button
            android:id="@+id/btnUpdateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Status"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambah Barang / Jasa"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="18dp" />

        <AutoCompleteTextView
            android:id="@+id/autoBarangJasa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cari barang / jasa"
            android:completionThreshold="1"
            android:layout_marginTop="6dp" />

        <EditText
            android:id="@+id/etQty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Qty"
            android:inputType="number"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnTambahBarang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tambah Barang / Jasa"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detail Barang &amp; Jasa"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="18dp" />

        <ListView
            android:id="@+id/listDetailBarang"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnKembali"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kembali"
            android:layout_marginTop="18dp" />

    </LinearLayout>

</ScrollView>