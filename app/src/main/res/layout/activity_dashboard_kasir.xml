<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dashboard Kasir"
        android:textSize="25sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnBuatAkunCustomer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buat Akun Customer"/>

    <Button
        android:id="@+id/btnMenuServis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Menu Servis"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnTambahProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tambah Progress"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:layout_marginTop="10dp"/>

</LinearLayout>