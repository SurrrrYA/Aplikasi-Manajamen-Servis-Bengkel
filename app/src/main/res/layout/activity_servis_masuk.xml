<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hubungkan Akun Customer (Opsional)"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etUsernameCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Username / Email / No HP"/>

        <Button
            android:id="@+id/btnCariAkun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hubungkan Akun Customer"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data Servis Motor"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etPlat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Plat Nomor"/>

        <EditText
            android:id="@+id/etNama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama Pemilik / STNK"/>

        <EditText
            android:id="@+id/etNoHp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="No HP"/>

        <EditText
            android:id="@+id/etAlamat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Alamat"/>

        <EditText
            android:id="@+id/etMerk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Merk Motor"/>

        <EditText
            android:id="@+id/etTipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tipe Motor"/>

        <EditText
            android:id="@+id/etKeluhan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Keluhan"/>

        <Button
            android:id="@+id/btnSimpan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan Servis"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/btnKembali"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kembali"/>

    </LinearLayout>

</ScrollView>