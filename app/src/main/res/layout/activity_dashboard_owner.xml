<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard Owner"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ringkasan Bengkel"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/txtTotalServis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Servis Hari Ini : 0"
                android:textSize="16sp"
                android:padding="14dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/txtPendapatanHariIni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pendapatan Hari Ini : Rp 0"
                android:textSize="16sp"
                android:padding="14dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/txtServisBelumSelesai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Servis Belum Selesai : 0"
                android:textSize="16sp"
                android:padding="14dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/txtServisMenginap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Servis Menginap : 0"
                android:textSize="16sp"
                android:padding="14dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu Cepat"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnInventori"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inventori Barang"/>

            <Button
                android:id="@+id/btnJasa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data Jasa"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/btnLaporan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Laporan"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:layout_marginTop="24dp"/>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:menu="@menu/bottom_owner_menu"/>

</RelativeLayout>